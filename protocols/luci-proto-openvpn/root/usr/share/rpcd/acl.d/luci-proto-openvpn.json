{
	"luci-proto-openvpn": {
		"description": "Grant access to LuCI openvpn procedures",
		"read": {
			"file": {
				"/etc/openvpn": [ "list" ],
				"/etc/openvpn/*": [ "list", "read" ]
			},
			"ubus": {
				"file": [ "list", "read", "stat" ],
				"luci.openvpn": [ "getSKeys" ]
			},
			"uci": [ "network" ]
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/etc/openvpn/*": [ "write" ]
			},
			"ubus": {
				"file": [ "remove", "write" ],
				"luci.openvpn": [ "generateKey", "prepareProfile" ]
			},
			"uci": [ "network" ]
		}
	}
}
