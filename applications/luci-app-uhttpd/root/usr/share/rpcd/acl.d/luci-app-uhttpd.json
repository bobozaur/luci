{
	"luci-app-uhttpd": {
		"description": "Grant UCI access for luci-app-uhttpd",
		"read": {
			"uci": ["uhttpd"],
			"file": {
				"/": ["list"],
				"/*": ["list"]
			},
			"ubus": {
				"file": ["list", "stat"],
				"uci": ["changes", "get"]
			}
		},
		"write": {
			"uci": ["uhttpd"],
			"cgi-io": ["upload"],
			"file": {
				"/etc/luci-uploads/*": ["write"],
				"/etc/uhttpd.key": ["write"],
				"/etc/uhttpd.crt": ["write"],
				"/bin/ubus call service event {\"type\":\"config.change\",\"data\":{\"package\":\"uhttpd\"}}": ["exec"]
			},
			"ubus": {
				"file": ["exec", "remove"]
			}
		}
	}
}
